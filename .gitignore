# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# hydra / mlflow / run outputs
outputs/
multirun/
mlruns/
mlruns.db
mlruns.db-journal
