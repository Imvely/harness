data/processed/*
!data/processed/.gitkeep
data/manifests/adaptation/*
!data/manifests/adaptation/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.npy

# local derived indexes / approvals (never committed)
experiments/registry.jsonl
experiments/approvals/*
!experiments/approvals/.gitkeep

# dvc
.dvc/cache
.dvc/tmp

# misc
.env
research/papers/pdf/
.claude/settings.local.json
.claude/agent-memory/
